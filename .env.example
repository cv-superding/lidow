# Web 服务监听地址：默认只允许本机；远程访问请改成 0.0.0.0 并设置访问令牌
LIDOW_BIND_ADDR=127.0.0.1
# 宿主机端口（容器内固定 6080）
LIDOW_WEB_PORT=6080
# 远程访问时强烈建议设置；设置后访问地址需带 ?token=...
LIDOW_WEB_TOKEN=
# 隐藏 Electron 宿主的虚拟屏幕分辨率（用户看不到这个桌面）
LIDOW_SCREEN=1360x860x24
# Debian 包源；默认阿里云镜像，海外网络可改成 deb.debian.org
APT_MIRROR=mirrors.aliyun.com
# 软件渲染（0）；宿主有 /dev/dri 且自行透传显卡时可设 1
LIDOW_ENABLE_GPU=0
# 容器内写文件使用的 UID/GID；Linux 下建议与宿主用户一致
PUID=1000
PGID=1000
TZ=Asia/Shanghai
